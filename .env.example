# Server
PORT=3000
NODE_ENV=development

# Data
DATABASE_URL=postgresql://prreview:prreview@localhost:5432/prreview
REDIS_URL=redis://localhost:6379

# Chat — DeepSeek V4 Flash (official API)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# Embeddings — local Qwen3 (OpenAI-compatible server you run)
EMBEDDING_BASE_URL=http://127.0.0.1:8000/v1
EMBEDDING_API_KEY=local
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# EMBEDDING_DIMENSIONS=1024

# GitHub App
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Protect REST / HITL routes
API_AUTH_TOKEN=

# Policy
HITL_CONFIDENCE_THRESHOLD=0.75
DAILY_BUDGET_USD=20
AUTO_POST_ENABLED=false
